{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.cargo/bin/miaudit session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.cargo/bin/miaudit capture --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|spawn_agent|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.cargo/bin/miaudit capture --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.cargo/bin/miaudit capture --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.cargo/bin/miaudit capture --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.cargo/bin/miaudit stop-check --agent codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
