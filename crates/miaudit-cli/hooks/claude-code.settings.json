{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$HOME/.cargo/bin/miaudit capture" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [ { "type": "command", "command": "$HOME/.cargo/bin/miaudit capture" } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [ { "type": "command", "command": "$HOME/.cargo/bin/miaudit capture" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.cargo/bin/miaudit stop-check" } ] }
    ]
  }
}
